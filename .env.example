# Autonomous Self-Healing CLI Agent - Environment Configuration

# Required: Gemini API Key for Gemma reasoning & autonomous patch synthesis
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: ElevenLabs API Key for real-time autonomous voice telemetry (--voice)
# Free creator tier available at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Voice ID configuration (Default: Rachel / "21m00Tcm4TlvDq8ikWAM")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: Model overrides
# Default text reasoning: gemma-2-27b-it (or gemma-2-9b-it)
# Default multimodal reasoning (with --image): gemini-2.5-flash
HEAL_TEXT_MODEL=gemma-2-27b-it
HEAL_MULTIMODAL_MODEL=gemini-2.5-flash
